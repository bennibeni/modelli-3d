# Copia questo file in .env.local (che non va su GitHub).

# Token dello store Blob, solo per `npm run upload-models`.
# Vercel → Storage → il tuo store Blob → .env.local / Quickstart.
BLOB_READ_WRITE_TOKEN=

# Cartella dei modelli su Blob, stampata da `npm run upload-models`.
# Va impostata nelle Environment Variables del progetto Vercel. In locale si
# può lasciare vuota: i modelli si leggono da public/models senza consumare
# il traffico gratuito di Blob.
NEXT_PUBLIC_MODELS_URL=

# Password del sito (Basic Auth, src/proxy.js). Su Vercel vanno impostate per
# Production e Preview: senza password il sito risponde 503. In locale, se
# SITE_AUTH_PASSWORD è vuota, l'accesso resta libero.
SITE_AUTH_USER=torre
SITE_AUTH_PASSWORD=
