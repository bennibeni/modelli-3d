{
  "name": "modelli-3d",
  "version": "1.0.0",
  "private": true,
  "description": "Visualizzatore di modelli 3D GLB con three.js: rotazione, zoom, tutto schermo, movimento di prova e apertura delle gambe",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix --max-warnings=0",
    "lint:a11y": "eslint . --config eslint.a11y.config.mjs --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:run": "vitest run",
    "test:watch": "vitest",
    "check": "npm run format:check && npm run lint:a11y && npm test && npm run build",
    "upload-models": "node --env-file-if-exists=.env.local scripts/upload-models.mjs"
  },
  "dependencies": {
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "three": "~0.186.1"
  },
  "devDependencies": {
    "@vercel/blob": "^2.8.2",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.2",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "prettier": "3.9.10",
    "vitest": "^5.0.5"
  }
}
